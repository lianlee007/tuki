      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (app, le) (rate(tuki_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{app}} p95",
          "refId": "A"
        }
      ],
      "title": "Latencia p95 por servicio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (app) (tuki_http_inflight_requests)",
          "legendFormat": "{{app}}",
          "refId": "A"
        }
