// Alloy: envía a Loki los logs de los contenedores `tukituki-prod-*`.
//
// Lee el socket de Docker en modo lectura. El filtro por nombre de contenedor
// evita recolectar los logs de los otros proyectos que conviven en el host.
// Las etiquetas `service` y `project` salen de las labels de Docker Compose.

logging {
  level  = "warn"
  format = "logfmt"
}

discovery.docker "tuki" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

discovery.relabel "tuki" {
  targets = discovery.docker.tuki.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/tukituki-prod-.*"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
}

loki.source.docker "tuki" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.tuki.targets
  relabel_rules = discovery.relabel.tuki.rules
  labels        = { job = "docker", entorno = "production" }
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
