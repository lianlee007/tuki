# Entorno de producción para Dokploy.
# Copiar a .env.production y reemplazar todos los valores.
# Nunca versionar el archivo con secretos reales.

# PostgreSQL
POSTGRES_PASSWORD=cambia-esta-clave-admin
IDENTIDAD_DB_PASSWORD=cambia-esta-clave-identidad
RESTAURANTES_DB_PASSWORD=cambia-esta-clave-restaurantes
MEDIA_DB_PASSWORD=cambia-esta-clave-media
PEDIDOS_DB_PASSWORD=cambia-esta-clave-pedidos
RESENAS_DB_PASSWORD=cambia-esta-clave-resenas

# Sesiones y verificación de JWT entre servicios
JWT_SECRETO=cambia-por-un-secreto-de-al-menos-32-caracteres

# Almacenamiento S3 compatible (RustFS)
S3_ACCESS_KEY=cambia-esta-clave-s3
S3_SECRET_KEY=cambia-este-secreto-s3

# IA
GROQ_API_KEY=
AI_GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,allam-2-7b

# Superadmin inicial
SUPERADMIN_EMAIL=admin@tukituki.local
SUPERADMIN_PASSWORD=cambia-esta-clave-superadmin
SUPERADMIN_NOMBRE=Super
SUPERADMIN_APELLIDO=Admin

# URL pública del API (la que ven los navegadores)
TUKI_API_URL=http://169.58.151.195:8084

# Orígenes permitidos por CORS: los tres frontends
CORS_ORIGENES=http://169.58.151.195:8081,http://169.58.151.195:8082,http://169.58.151.195:8083
