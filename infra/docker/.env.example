# Entorno local de TukiTuki.
# Copiar a .env y ajustar. Nunca versionar valores reales.

NODE_ENV=development

# PostgreSQL local
DATABASE_URL=postgres://tuki_identidad:tuki_identidad_dev@localhost:5432/tuki_identidad
DATABASE_URL_RESTAURANTES=postgres://tuki_restaurantes:tuki_restaurantes_dev@localhost:5432/tuki_restaurantes

# Identidad
PUERTO=3001
JWT_SECRETO=cambio-este-secreto-en-produccion
JWT_EMISOR=tuki-identidad
JWT_AUDIENCIA=tuki
CORS_ORIGENES=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8081,http://localhost:8082,http://localhost:8083

# URLs públicas del stack completo en Docker. `docker-compose.yml` ya las fija
# para local; se documentan aquí para los procesos que corran fuera de Docker.
TUKI_API_URL=http://localhost:8084
TUKI_WEB_URL=http://localhost:8081
TUKI_PANEL_URL=http://localhost:8082
TUKI_ADMIN_PANEL_URL=http://localhost:8083

# Superadmin inicial (solo para el script de creación)
SUPERADMIN_EMAIL=admin@tukituki.local
SUPERADMIN_PASSWORD=Admin12345

# Almacenamiento local (RustFS, API compatible con S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tuki-media
S3_ACCESS_KEY=tuki_s3
S3_SECRET_KEY=tuki_s3_dev
S3_PUBLIC_URL=http://localhost:9000/tuki-media

# IA (opcional en local; sin clave el gateway arranca pero no está listo)
# Sin `GROQ_API_KEY` puedes usar el Ollama de la máquina, que habla el mismo
# protocolo OpenAI. Requiere `ollama pull qwen2.5:1.5b-instruct` y descomentar:
# GROQ_API_KEY=ollama-local
# AI_GROQ_BASE_URL=http://host.docker.internal:11434/v1
# AI_GROQ_MODELS=qwen2.5:1.5b-instruct
# AI_GROQ_TIMEOUT_SECONDS=120
# AI_GROQ_TOTAL_TIMEOUT_SECONDS=180
GROQ_API_KEY=
AI_GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,allam-2-7b

# Ollama del stack (contenedor). Para usar el del host: http://host.docker.internal:11434
AI_OLLAMA_URL=http://ollama:11434
