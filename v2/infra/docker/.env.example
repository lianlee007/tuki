# Entorno local de Tuki v2.
# Copiar a .env y ajustar. Nunca versionar valores reales.

NODE_ENV=development

# PostgreSQL local
DATABASE_URL=postgres://tuki_identidad:tuki_identidad_dev@localhost:5432/tuki_identidad

# Identidad
PUERTO=3001
JWT_SECRETO=cambio-este-secreto-en-produccion
JWT_EMISOR=tuki-identidad
JWT_AUDIENCIA=tuki
CORS_ORIGENES=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Superadmin inicial (solo para el script de creación)
SUPERADMIN_EMAIL=admin@tuki.local
SUPERADMIN_PASSWORD=Admin12345

# Almacenamiento local
MINIO_ENDPOINT=localhost
MINIO_PUERTO=9000
MINIO_USUARIO=tuki_minio
MINIO_CLAVE=tuki_minio_dev
MINIO_BUCKET=tuki-media
