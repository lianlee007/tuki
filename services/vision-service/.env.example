# Servicio de visión local (Ultralytics).
# Copia este archivo como .env.local o exporta las variables en la shell.

# Ruta de los pesos. En Docker se resuelve a /app/modelos/comida-v1.pt.
VISION_MODEL_PATH=modelos/comida-v1.pt
# Probabilidad mínima de "comida" para aceptar una foto.
VISION_UMBRAL_COMIDA=0.3
VISION_ETIQUETA_COMIDA=comida
VISION_IMGSZ=224
# cpu o el id de la GPU (0, 1…).
VISION_DEVICE=cpu
# Ultralytics no debe buscar actualizaciones ni instalar dependencias en runtime.
YOLO_OFFLINE=true
YOLO_AUTOINSTALL=false
VISION_MAX_IMAGEN_BYTES=8388608
VISION_ENVIRONMENT=development
VISION_LOG_LEVEL=INFO
# Orígenes permitidos por CORS (separados por coma). Vacío = sin CORS; en
# desarrollo la SPA usa el proxy de Vite y en Docker el de Nginx.
VISION_CORS_ORIGINS=
