# =============================================================================
# AI Gateway — variables para ejecutarlo sin Docker.
#
#   cd services/ai-gateway
#   python -m venv .venv
#   .venv\Scripts\pip install -r requirements-dev.txt   (Windows)
#   .venv/bin/pip install -r requirements-dev.txt        (Linux/macOS)
#   uvicorn app.main:app --reload --port 8001
#
# En local lo más cómodo es AI_AUTH_MODE=disabled y llamar sin token.
# =============================================================================

AI_ENVIRONMENT=development
AI_LOG_LEVEL=INFO

# disabled | supabase
AI_AUTH_MODE=disabled
AI_ALLOW_ANON=true

# Obligatoria en Supabase (también para descargar el JWKS)
SUPABASE_URL=
# Clave pública del proyecto. Necesaria en proyectos con JWT HS256 (anteriores
# a las claves asimétricas): su JWKS está vacío y el token se valida en GoTrue.
SUPABASE_ANON_KEY=
# AI_SUPABASE_JWKS_URL=
# AI_SUPABASE_ISSUER=
# AI_SUPABASE_AUDIENCE=authenticated

# --- Modelo local (Ollama) ---------------------------------------------------
# Ollama escucha en 11434. En Docker usa http://host.docker.internal:11434.
AI_OLLAMA_URL=http://localhost:11434
# Se crea con: ollama create tuki-chef -f services/ai-gateway/Modelfile
AI_OLLAMA_MODELO_CHAT=tuki-chef
# Si tuki-chef todavía no existe, el gateway usa este modelo ya descargado.
AI_OLLAMA_MODELO_RESPALDO=qwen2.5:1.5b-instruct
AI_OLLAMA_MODELO_EMBEDDINGS=nomic-embed-text
AI_OLLAMA_KEEP_ALIVE=15m
AI_OLLAMA_NUM_CTX=3072

# --- RAG --------------------------------------------------------------------
# El gateway pide el catálogo por HTTP; no lee PostgreSQL directamente.
AI_RESTAURANTES_URL=http://localhost:3002
AI_RESENAS_URL=http://localhost:3005
AI_CONOCIMIENTO_TTL_SECONDS=300
AI_CONOCIMIENTO_MAX_RESTAURANTES=200
# AI_RAG_CHUNK_TOKENS=220
# AI_RAG_CHUNK_OVERLAP=40
# AI_RAG_TOP_K=6
# AI_RAG_CONTEXTO_MAX_TOKENS=1100

# Opcionales
# AI_RATE_LIMIT_ANON_PER_MINUTE=10
# AI_RATE_LIMIT_ANON_BURST=4
# AI_RATE_LIMIT_AUTH_PER_MINUTE=30
# AI_RATE_LIMIT_AUTH_BURST=8
# AI_CORS_ORIGINS=http://localhost:3000
# AI_OTEL_ENABLED=false
# AI_OTEL_ENDPOINT=http://localhost:4318/v1/traces
