# =============================================================================
# AI Gateway — variables para ejecutarlo sin Docker.
#
#   cd services/ai-gateway
#   python -m venv .venv
#   .venv\Scripts\pip install -r requirements-dev.txt   (Windows)
#   .venv/bin/pip install -r requirements-dev.txt        (Linux/macOS)
#   uvicorn app.main:app --reload --port 8001
#
# En local lo más cómodo es AI_AUTH_MODE=disabled y llamar sin token.
# =============================================================================

AI_ENVIRONMENT=development
AI_LOG_LEVEL=INFO

# disabled | supabase
AI_AUTH_MODE=disabled
AI_ALLOW_ANON=true

# Obligatoria en Supabase (también para descargar el JWKS)
SUPABASE_URL=
# AI_SUPABASE_JWKS_URL=
# AI_SUPABASE_ISSUER=
# AI_SUPABASE_AUDIENCE=authenticated

# Obligatoria para generar contenido
GROQ_API_KEY=

# Opcionales
# AI_GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,allam-2-7b
# AI_GROQ_TIMEOUT_SECONDS=25
# AI_GROQ_TOTAL_TIMEOUT_SECONDS=40
# AI_RATE_LIMIT_ANON_PER_MINUTE=10
# AI_RATE_LIMIT_ANON_BURST=4
# AI_RATE_LIMIT_AUTH_PER_MINUTE=30
# AI_RATE_LIMIT_AUTH_BURST=8
# AI_CORS_ORIGINS=http://localhost:3000
# AI_OTEL_ENABLED=false
# AI_OTEL_ENDPOINT=http://localhost:4318/v1/traces
