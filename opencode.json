{
  "$schema": "https://opencode.ai/config.json",
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 16000
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    },
    "buffer": 32000
  },
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": [
          "node",
          "scripts/mcp-codegraph.mjs"
        ],
        "disabled": false
      },
      "engram": {
        "type": "local",
        "command": [
          "node",
          "scripts/mcp-engram.mjs"
        ],
        "disabled": false
      }
    }
  }
}
