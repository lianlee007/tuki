{
  "$schema": "https://opencode.ai/config.json",
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 16000
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    },
    "buffer": 32000
  },
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": [
          "node",
          "scripts/mcp-codegraph.mjs"
        ],
        "disabled": false
      },
      "engram": {
        "type": "local",
        "command": [
          "node",
          "scripts/mcp-engram.mjs"
        ],
        "disabled": false
      },
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=eroezvbfxqfrjtojaqus&read_only=true&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
        "enabled": true
      }
    }
  }
}
