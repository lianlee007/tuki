{
  "_comentario": "Reglas de caché (fase http_request_cache_settings). Los assets de Vite llevan hash en el nombre, así que son inmutables; el HTML y la API nunca se cachean.",
  "fase": "http_request_cache_settings",
  "reglas": [
    {
      "description": "tuki-cache-assets",
      "action": "set_cache_settings",
      "enabled": true,
      "expression": "(starts_with(http.request.uri.path, \"/assets/\")) or (http.request.uri.path matches \"\\.(css|js|woff2?|svg|png|jpe?g|webp|avif|ico)$\")",
      "action_parameters": {
        "cache": true,
        "edge_ttl": { "mode": "override_origin", "default": 31536000 },
        "browser_ttl": { "mode": "override_origin", "default": 31536000 },
        "cache_key": {
          "custom_key": {
            "query_string": { "exclude": "*" }
          }
        }
      }
    },
    {
      "description": "tuki-sin-cache-html",
      "action": "set_cache_settings",
      "enabled": true,
      "expression": "(http.request.uri.path eq \"/\" or http.request.uri.path matches \"\\.html$\")",
      "action_parameters": {
        "cache": false
      }
    },
    {
      "description": "tuki-sin-cache-api",
      "action": "set_cache_settings",
      "enabled": true,
      "expression": "(starts_with(http.request.uri.path, \"/api/\")) or (starts_with(http.request.uri.path, \"/healthz\"))",
      "action_parameters": {
        "cache": false
      }
    }
  ]
}
