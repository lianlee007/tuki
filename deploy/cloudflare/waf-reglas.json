{
  "_comentario": "Reglas propias de WAF y rate limit. Formato Rulesets API v4; las aplica scripts/cloudflare/aplicar-reglas.mjs. Los IDs no se guardan: el script resuelve la ruleset de la zona.",
  "fase": "http_request_firewall_custom",
  "reglas": [
    {
      "description": "tuki-metodos-permitidos",
      "action": "block",
      "enabled": true,
      "expression": "not http.request.method in {\"GET\" \"POST\" \"HEAD\" \"OPTIONS\"}"
    },
    {
      "description": "tuki-user-agent-vacio",
      "action": "managed_challenge",
      "enabled": true,
      "expression": "(http.user_agent eq \"\" or len(http.user_agent) lt 12) and http.request.uri.path ne \"/healthz\""
    },
    {
      "description": "tuki-scaner-rutas-sensibles",
      "action": "block",
      "enabled": true,
      "expression": "(http.request.uri.path matches \"(^|/)(\\.env|\\.git|wp-admin|wp-login|phpmyadmin|xmlrpc\\.php|server-status)(/|$)\")"
    },
    {
      "description": "tuki-origen-solo-tunnel",
      "action": "block",
      "enabled": true,
      "expression": "(http.request.uri.path eq \"/api/chat\" and not cf.tls_client_auth.cert_verified) and cf.edge.server_port ne 443"
    }
  ],
  "rate_limit": {
    "fase": "http_ratelimit",
    "reglas": [
      {
        "description": "tuki-rate-limit-api",
        "action": "block",
        "enabled": true,
        "expression": "(http.request.uri.path matches \"^/api/\") and http.request.method eq \"POST\"",
        "ratelimit": {
          "characteristics": ["ip.src", "cf.colo.id"],
          "period": 60,
          "requests_per_period": 60,
          "mitigation_timeout": 60
        }
      },
      {
        "description": "tuki-rate-limit-chat",
        "action": "block",
        "enabled": true,
        "expression": "(http.request.uri.path eq \"/api/chat\")",
        "ratelimit": {
          "characteristics": ["ip.src"],
          "period": 60,
          "requests_per_period": 20,
          "mitigation_timeout": 300
        }
      }
    ]
  }
}
