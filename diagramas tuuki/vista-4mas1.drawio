        <mxCell id="title" value="&lt;span style=&quot;font-size:26px&quot;&gt;&lt;b&gt;Vista de desarrollo&lt;/b&gt;&lt;/span&gt;&lt;div style=&quot;font-size:13px;color:#64748B;margin-top:4px&quot;&gt;El repositorio, las reglas que se vigilan y la entrega.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="1100" height="74" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="Modelo 4+1 · TukiTuki" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#94A3B8;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="1600" height="18" as="geometry" />
        </mxCell>
        <mxCell id="d_repo" value="&lt;b&gt;Repositorio · workspace pnpm&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=8 6;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;html=1;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="520" height="330" as="geometry" />
        </mxCell>
        <mxCell id="d_tree" value="&lt;table style=&quot;font-size:12px;line-height:1.9;border-collapse:collapse&quot;&gt;&lt;tr&gt;&lt;td style=&quot;font-family:Courier New;font-weight:bold;padding-right:16px&quot;&gt;apps/&lt;/td&gt;&lt;td&gt;3 frontends Vite&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-family:Courier New;font-weight:bold;padding-right:16px&quot;&gt;services/&lt;/td&gt;&lt;td&gt;6 Node + 2 Python&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-family:Courier New;font-weight:bold;padding-right:16px&quot;&gt;packages/&lt;/td&gt;&lt;td&gt;dominio · API · auth · UI&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-family:Courier New;font-weight:bold;padding-right:16px&quot;&gt;db/ e2e/&lt;/td&gt;&lt;td&gt;seeds · Playwright&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-family:Courier New;font-weight:bold;padding-right:16px&quot;&gt;infra/&lt;/td&gt;&lt;td&gt;docker · k8s · argocd&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-family:Courier New;font-weight:bold;padding-right:16px&quot;&gt;docs/&lt;/td&gt;&lt;td&gt;arquitectura y marca&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="84" y="168" width="475" height="220" as="geometry" />
        </mxCell>
        <mxCell id="d_reglas" value="&lt;b&gt;Reglas que se vigilan&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=8 6;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;html=1;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="610" y="120" width="520" height="330" as="geometry" />
        </mxCell>
        <mxCell id="d_reglas_txt" value="&lt;b&gt;1 · Dominio puro.&lt;/b&gt; &lt;font style=&#39;font-size:11px&#39;&gt;No importa React, Fastify, PostgreSQL ni variables de entorno.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2 · Hexagonal.&lt;/b&gt; &lt;font style=&#39;font-size:11px&#39;&gt;entrada → aplicación → dominio; los adaptadores implementan los puertos.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3 · Sin tablas ajenas.&lt;/b&gt; &lt;font style=&#39;font-size:11px&#39;&gt;Cada servicio lee su base; entre servicios se habla por REST.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;4 · Un solo cliente HTTP.&lt;/b&gt; &lt;font style=&#39;font-size:11px&#39;&gt;Nada de fetch en componentes; todo pasa por @tuki/api-cliente.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;5 · Configuración en runtime.&lt;/b&gt; &lt;font style=&#39;font-size:11px&#39;&gt;Los frontends reciben /config.js, no URLs compiladas.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="634" y="168" width="475" height="240" as="geometry" />
        </mxCell>
        <mxCell id="d_calidad" value="&lt;b&gt;Puertas de calidad&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=8 6;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;html=1;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="1160" y="120" width="460" height="330" as="geometry" />
        </mxCell>
        <mxCell id="d_calidad_txt" value="&lt;b&gt;Typecheck · test · build&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Todo el workspace pnpm.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Playwright E2E&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Los tres frontends con APIs simuladas.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ruff + pytest&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;AI Gateway y visión.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Kustomize&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Overlays local y producción.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CodeQL · gitleaks&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Seguridad y secretos.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Humo + k6&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Stack real y carga.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1184" y="168" width="415" height="240" as="geometry" />
        </mxCell>
        <mxCell id="d_entrega" value="&lt;b&gt;Entrega · del commit al clúster&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=8 6;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=1.4;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;html=1;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
