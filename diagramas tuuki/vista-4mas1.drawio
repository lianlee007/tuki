  <diagram id="vista-desarrollo" name="Vista de desarrollo">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="760" background="#ffffff" math="0" shadow="0">
      <root>
