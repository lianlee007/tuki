        <mxCell id="d_e1" value="&lt;b&gt;Commit / PR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;revisión y CI&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.3;fontColor=#0F172A;fontSize=12;" vertex="1" parent="1">
