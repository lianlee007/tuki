# =============================================================================
# Variables de entorno de Riki.
#
# Copia este archivo a `.env.local` para desarrollo o usa:
#   docker compose --env-file .env.local up -d --build
#
# Todas las variables VITE_* terminan incrustadas en el bundle del navegador:
# son públicas por diseño. No pongas aquí secretos de servidor salvo
# GROQ_API_KEY, que solo se inyecta en el contenedor `ai-gateway` en runtime.
# =============================================================================

# Supabase (obligatorias)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary (obligatorias para subir imágenes)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# AI Gateway (opcional). Por defecto `/api`, que funciona con el proxy de Vite,
# Nginx y el Ingress. Solo cámbialo si el gateway vive en otro origen.
# VITE_AI_GATEWAY_URL=/api

# Groq (obligatoria para el AI Gateway; ya no se incrusta en el bundle)
GROQ_API_KEY=

# --- AI Gateway -------------------------------------------------------------
# En local se usa `disabled`; en producción `supabase`.
# AI_AUTH_MODE=disabled
# AI_ALLOW_ANON=true
# AI_ENVIRONMENT=development
# AI_LOG_LEVEL=INFO
# AI_GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,allam-2-7b
# AI_GROQ_TIMEOUT_SECONDS=25
# AI_GROQ_TOTAL_TIMEOUT_SECONDS=40
# AI_RATE_LIMIT_ANON_PER_MINUTE=10
# AI_RATE_LIMIT_ANON_BURST=4
# AI_RATE_LIMIT_AUTH_PER_MINUTE=30
# AI_RATE_LIMIT_AUTH_BURST=8
# AI_OTEL_ENABLED=false
# AI_OTEL_ENDPOINT=http://localhost:4318/v1/traces

# Supabase para el gateway en producción (no hace falta en local con
# AI_AUTH_MODE=disabled).
# SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Solo para Docker Compose (opcionales)
# RIKI_PORT=8080
# RIKI_VERSION=local
# RIKI_IMAGE=riki
# AI_GATEWAY_PORT=8001
# AI_GATEWAY_IMAGE=riki-ai-gateway
# Si lo pones en true, instala OpenTelemetry al construir la imagen; además
# necesitas AI_OTEL_ENABLED=true arriba.
# AI_WITH_OTEL=false
